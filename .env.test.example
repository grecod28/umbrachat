# Copy to .env.test at the repository root.
# docker-compose.test.yml exposes PostgreSQL on 5433 to avoid clashing with
# a local development database on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/umbrachat_test?schema=public

JWT_SECRET=umbra-test-jwt-secret-change-me
REDIS_URL=redis://localhost:6380
THROTTLE_LIMIT=10000
IP_THROTTLE_LIMIT=10000
SESSION_THROTTLE_LIMIT=10000
THROTTLE_BLOCK_MS=1000

AWS_S3_BUCKET_NAME=umbra-test-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key

E2E_API_URL=http://localhost:3001
PLAYWRIGHT_BASE_URL=http://localhost:3000
