# Copiar a .env.production en el VPS (o a .env.local en desarrollo).
# Las variables NEXT_PUBLIC_* se insertan en el bundle durante el build,
# por eso el deploy compila en el servidor con este archivo presente.

NEXT_PUBLIC_API_URL=https://back.umbrachat.org
NEXT_PUBLIC_SOCKET_URL=https://socket.umbrachat.org
