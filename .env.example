# Variables del backend, Prisma y PostgreSQL.
# Copiar a .env en el VPS y completar con valores reales.
# Este archivo NO se usa en desarrollo salvo que se copie manualmente.

# PostgreSQL (docker-compose.yml)
DB_PORT=5432
DB_NAME=umbrachat
DB_USER=umbrachat
DB_PASSWORD=cambiar-por-un-password-fuerte

# Prisma / NestJS
DATABASE_URL=postgresql://umbrachat:cambiar-por-un-password-fuerte@127.0.0.1:5432/umbrachat?schema=public
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Puertos de la API REST y Socket.IO
PORT=3001
WS_PORT=3002

# Anti-spam (HTTP)
# Límite por IP y por sesión anónima en ventanas de 60 segundos.
IP_THROTTLE_LIMIT=120
SESSION_THROTTLE_LIMIT=60
THROTTLE_BLOCK_MS=300000

# Amazon S3 (subida de archivos)
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
