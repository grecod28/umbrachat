generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String    @id @default(uuid())
  name String @default("Untitled Chat") @db.VarChar(120)
  description String @default("") @db.VarChar(2048)
  createdAt DateTime @default(now())
  lastMessageAt DateTime  @default(now())

  items  ChatItem[]
  access      RoomAccess?
  @@index([lastMessageAt]) // Importante para la velocidad
}

model RoomAccess {
  roomId       String @id
  passwordHash String @db.VarChar(255)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model ChatItem {
  id        String   @id @default(uuid())
  roomId    String
  createdAt DateTime @default(now())

  message Message?
  file File?
  room      Room     @relation(fields: [roomId], references: [id])
} 

model Message {
  itemId  String @id
  content   String

  item ChatItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model File {
  itemId  String @id
  key     String
  fileName String
  mimeType String
  size    Int

  item ChatItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}