generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String    @id @default(uuid())
  name      String
  messages  Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
}